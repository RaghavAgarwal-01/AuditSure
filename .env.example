# AuditSure Layer 3 - Groq LLM explanation
GROQ_API_KEY=

# Groq model used for plain-English compliance explanations
GROQ_MODEL=llama-3.3-70b-versatile

# --- api/ (FastAPI HTTP layer) ---

# Comma-separated list of allowed browser origins for CORS.
# The React dev server defaults to http://localhost:5173.
AUDITSURE_CORS_ORIGINS=http://localhost:5173

# development | production - informational only, does not gate any
# security-sensitive behavior by itself.
AUDITSURE_ENV=development

# Host/port used when running `python -m uvicorn api.main:app`
# without explicit --host/--port flags (see README.md).
API_HOST=127.0.0.1
API_PORT=8000

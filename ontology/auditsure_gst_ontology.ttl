    gst:isSpecialCategory "false"^^xsd:boolean ;
    gst:sourceNote "Also typed gst:State per Sec 2(103), CGST Act 2017 ('State includes a Union territory with Legislature') - Delhi (NCT) has a Legislative Assembly." ;
    rdfs:label "Delhi (National Capital Territory)"@en .
gst:JammuandKashmir a owl:NamedIndividual, gst:UnionTerritory, gst:State ;
    gst:isSpecialCategory "false"^^xsd:boolean ;
    gst:sourceNote "Also typed gst:State per Sec 2(103), CGST Act 2017 - J&K has held Union Territory status with a Legislature since the Jammu and Kashmir Reorganisation Act, 2019. Note: J&K was EXCLUDED from special-category treatment for Sec 22 threshold purposes by the same amendment referenced on gst:SpecialCategoryState." ;
    rdfs:label "Jammu and Kashmir"@en .

#################################################################
#  INDIVIDUALS: COMPOSITION SCHEMES / CIRCULARS / MISC
#################################################################

gst:CompositionSchemeGoods a owl:NamedIndividual, gst:CompositionLevyGoods ;
    gst:hasThreshold gst:ThresholdCompositionGoods1_5Cr, gst:ThresholdCompositionGoodsSpecialCategory75L ;
    gst:hasApplicableSection gst:CGST_Section10 ;
    rdfs:label "Composition Scheme for Goods/Restaurant Services (Sec 10(1))"@en .
gst:CompositionSchemeServices a owl:NamedIndividual, gst:CompositionLevyServices ;
    gst:hasThreshold gst:ThresholdCompositionServices50L ;
    gst:hasApplicableSection gst:CGST_Section10 ;
    rdfs:label "Composition Scheme for Services (Sec 10(2A))"@en .

gst:Circular_198_2023_GST a owl:NamedIndividual, gst:Circular ;
    gst:circularNumber "198/10/2023-GST" ;
    rdfs:comment "Clarification on an issue pertaining to e-invoice."@en ;
    rdfs:label "Circular 198/10/2023-GST"@en .

#################################################################
#  INDIVIDUALS: A FEW REPRESENTATIVE BUSINESS-TYPE / OFFENCE / SUPPLY EXAMPLES
#  (Illustrative NamedIndividuals of the classes above, useful as seed data
#   for Z3 constraint testing / OWLAPI unit tests.)
#################################################################

gst:ExampleManufacturerBusiness a owl:NamedIndividual, gst:Manufacturer ;
    rdfs:comment "Illustrative individual for testing: a manufacturing business type instance."@en .
gst:ExampleServiceProviderBusiness a owl:NamedIndividual, gst:ServiceProvider ;
    rdfs:comment "Illustrative individual for testing: a service-provider business type instance."@en .
gst:ExampleCompositionEligibleBusiness a owl:NamedIndividual, gst:CompositionTaxpayer ;
    gst:turnoverAmount "8000000"^^xsd:decimal ;
    gst:isEligibleForComposition gst:CompositionSchemeGoods ;
    rdfs:comment "Illustrative individual: a registered person with Rs 80 lakh turnover, eligible for the goods composition scheme (below the Rs 1.5 crore Sec 10(1) threshold)."@en .

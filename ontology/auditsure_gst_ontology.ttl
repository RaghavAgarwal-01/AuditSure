    gst:notificationNumber "09/2017-CT" ; gst:notificationDate "2017-06-28T00:00:00"^^xsd:dateTime ;
    rdfs:comment "Brought into force the bulk of the remaining CGST Act sections w.e.f. 01.07.2017."@en ;
    rdfs:label "Notification 09/2017-CT"@en .
gst:Notification_02_2019_CT a owl:NamedIndividual, gst:Notification ;
    gst:notificationNumber "02/2019-CT" ; gst:notificationDate "2019-01-29T00:00:00"^^xsd:dateTime ;
    gst:issuedUnderSection gst:CGST_Section7 ;
    rdfs:comment "Brought into force amendments to Sec 7 (scope of supply) made by the CGST (Amendment) Act, 2018, w.e.f. 01.02.2019."@en ;
    rdfs:label "Notification 02/2019-CT"@en .

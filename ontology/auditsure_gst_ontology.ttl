@prefix :     <http://www.auditsure.in/ontology/gst#> .
@prefix gst:  <http://www.auditsure.in/ontology/gst#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

#################################################################
#  AuditSure GST Legal Knowledge Ontology
#  ---------------------------------------------------------------
#  Layer 1 of the AuditSure Neuro-Symbolic Compliance Architecture
#  (Layer 2 = Z3 Solver, Layer 3 = LLM explanation generator)
#
#  Scope   : Central Goods and Services Tax Act 2017 & Rules 2017,
#            Integrated Goods and Services Tax Act 2017 & Rules 2017,
#            GST (Compensation to States) Act 2017 & Rules,
#            GST Appellate Tribunal Rules 2023 / Procedure Rules 2025.
#  Source  : "GST Manual" (Sixth Half-Yearly Edition, 01 January 2026),
#            Adv. (CA) Rakesh Garg & Sandeep Garg, CMA, FCA.
#            Only the statutory text (Bare Acts / Rules), section
#            numbers, thresholds, rates, and notification/circular
#            citations reproduced in that compilation have been used.
#            No commentary/analysis text from the compilation has been
#            reproduced; all rdfs:comment annotations are original
#            paraphrase written for ontology documentation purposes.
#  Author  : Generated for the "AuditSure" B.Tech capstone project.
#  Note    : Where the source manual did not enumerate a value
#            (e.g. current HSN-wise GST rate slabs, full Article 279A
#            special-category-state list), a placeholder individual /
#            comment is used instead of an invented value, per project
#            instructions.
#
#  CHANGELOG
#  ---------
#  1.1.0 (Phase 2-8 corrections, surfaced by Z3 unit/integration testing):
#    - Added ThresholdCompositionGoodsSpecialCategory75L (was missing;
#      Sec 10(1) special-category composition ceiling).
#    - Renamed ThresholdCompositionGoods150Cr -> ThresholdCompositionGoods1_5Cr
#      (the old name misleadingly read as "150 Crore" instead of "1.5 Crore").
#    - Dual-typed Delhi (NCT), Jammu & Kashmir, and Puducherry as both
#      gst:UnionTerritory and gst:State, per Sec 2(103) CGST Act's explicit
#      inclusion of a Union Territory with Legislature within "State".
#    - Added an explicit Sec 10(4) citation to gst:CompositionLevy's ITC/
#      tax-collection bar (the underlying fact was already in the class
#      comment; the citation was added for traceability once Phase 8
#      integration testing surfaced that the Python ITC/e-invoicing engines
#      were not enforcing it).
#  1.0.0: initial release (Phase 1).
#################################################################

<http://www.auditsure.in/ontology/gst> rdf:type owl:Ontology ;
    owl:versionIRI <http://www.auditsure.in/ontology/gst/1.1.0> ;
    owl:versionInfo "1.1.0"^^xsd:string ;
    dct:title "AuditSure GST Legal Knowledge Ontology"@en ;
    dct:description "Formal OWL 2 representation of Indian GST law (CGST Act/Rules, IGST Act/Rules, GST Compensation Cess Act/Rules) for consumption by a Z3-based symbolic compliance reasoner in the AuditSure system."@en ;
    dct:source "GST Manual, Sixth Half Yearly Edition, 01 January 2026, by Adv. (CA) Rakesh Garg and Sandeep Garg, CMA, FCA"@en ;
    dct:created "2026-07-07T00:00:00"^^xsd:dateTime ;
    rdfs:comment "Do not use for filing or legal advice. Thresholds and rates are as consolidated in the source manual as on 01 January 2026 and are subject to subsequent notifications."@en .

#################################################################
#  Annotation Properties
#################################################################

gst:module a owl:AnnotationProperty ;
    rdfs:comment "Tags a class/property with the ontology module it belongs to (Step 9 modular design)."@en .

gst:legalCitation a owl:AnnotationProperty ;
    rdfs:comment "Human-readable legal citation (Act, Section, Rule) for an entity, for traceability back to statute."@en .

gst:sourceNote a owl:AnnotationProperty ;
    rdfs:comment "Notes on provenance / amendment history / placeholder status of a modelled fact."@en .

#################################################################
#  MODULE 1: CORE
#  Top-level classes shared across all other modules.
#################################################################

gst:GSTEntity a owl:Class ;
    gst:module "Core" ;
    rdfs:label "GST Entity"@en ;
    rdfs:comment "Root class for every legally significant entity recognised under Indian GST law (persons, authorities, documents, obligations, legal-reference artefacts)."@en .

### --- Legal Persons (definition 84 of Sec 2, CGST Act) ---

gst:LegalPerson a owl:Class ;
    rdfs:subClassOf gst:GSTEntity ;
    gst:module "Core" ;
    gst:legalCitation "Sec 2(84), CGST Act 2017" ;
    rdfs:label "Legal Person"@en ;
    rdfs:comment "A person as defined in Sec 2(84) CGST Act: includes an individual, HUF, company, firm, LLP, AOP/BOI, corporation, foreign body corporate, co-operative society, local authority, Central/State Government, society, trust, or any other artificial juridical person."@en .

gst:Individual a owl:Class ; rdfs:subClassOf gst:LegalPerson ; gst:module "Core" ; rdfs:label "Individual"@en .
gst:HinduUndividedFamily a owl:Class ; rdfs:subClassOf gst:LegalPerson ; gst:module "Core" ; rdfs:label "Hindu Undivided Family"@en .
gst:Company a owl:Class ; rdfs:subClassOf gst:LegalPerson ; gst:module "Core" ; rdfs:label "Company"@en .
gst:Firm a owl:Class ; rdfs:subClassOf gst:LegalPerson ; gst:module "Core" ; rdfs:label "Firm"@en .
gst:LimitedLiabilityPartnership a owl:Class ; rdfs:subClassOf gst:LegalPerson ; gst:module "Core" ; rdfs:label "Limited Liability Partnership"@en .
gst:AssociationOfPersons a owl:Class ; rdfs:subClassOf gst:LegalPerson ; gst:module "Core" ; rdfs:label "Association of Persons / Body of Individuals"@en .
gst:CooperativeSociety a owl:Class ; rdfs:subClassOf gst:LegalPerson ; gst:module "Core" ; rdfs:label "Co-operative Society"@en .
gst:LocalAuthorityPerson a owl:Class ; rdfs:subClassOf gst:LegalPerson ; gst:module "Core" ; rdfs:label "Local Authority (as person)"@en .
gst:GovernmentPerson a owl:Class ; rdfs:subClassOf gst:LegalPerson ; gst:module "Core" ; rdfs:label "Central/State Government (as person)"@en .
gst:SocietyPerson a owl:Class ; rdfs:subClassOf gst:LegalPerson ; gst:module "Core" ; rdfs:label "Society"@en .
gst:TrustPerson a owl:Class ; rdfs:subClassOf gst:LegalPerson ; gst:module "Core" ; rdfs:label "Trust"@en .
gst:ArtificialJuridicalPerson a owl:Class ; rdfs:subClassOf gst:LegalPerson ; gst:module "Core" ; rdfs:label "Artificial Juridical Person"@en .

[ a owl:AllDisjointClasses ;
    owl:members ( gst:Individual gst:HinduUndividedFamily gst:Company gst:Firm
                  gst:LimitedLiabilityPartnership gst:AssociationOfPersons
                  gst:CooperativeSociety gst:LocalAuthorityPerson gst:GovernmentPerson
                  gst:SocietyPerson gst:TrustPerson gst:ArtificialJuridicalPerson )
] .

### --- Jurisdiction ---

gst:Jurisdiction a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Core" ;
    rdfs:label "Jurisdiction"@en ;
    rdfs:comment "A geographic/administrative jurisdiction relevant to GST: a State or a Union Territory."@en .

gst:State a owl:Class ; rdfs:subClassOf gst:Jurisdiction ; gst:module "Core" ;
    gst:legalCitation "Sec 2(103), CGST Act 2017 (State includes a Union territory with Legislature)" ;
    rdfs:label "State"@en .

gst:UnionTerritory a owl:Class ; rdfs:subClassOf gst:Jurisdiction ; gst:module "Core" ; rdfs:label "Union Territory"@en .

gst:SpecialCategoryState a owl:Class ; rdfs:subClassOf gst:State ; gst:module "Core" ;
    gst:legalCitation "Explanation to Sec 22(1), CGST Act 2017; Article 279A(4)(g), Constitution of India" ;
    rdfs:label "Special Category State"@en ;
    rdfs:comment "For Sec 22 registration-threshold purposes, special category States means the States specified under Article 279A(4)(g) of the Constitution, EXCLUDING Jammu and Kashmir and EXCLUDING Arunachal Pradesh, Assam, Himachal Pradesh, Meghalaya, Sikkim and Uttarakhand (both exclusions inserted by amendment). The full Article 279A(4)(g) base list is a constitutional list not reproduced verbatim in the source manual; only the exclusions are drawn directly from Sec 22 as amended."@en .

### --- Government Authorities ---

gst:GovernmentAuthority a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Core" ;
    rdfs:label "Government Authority"@en ;
    rdfs:comment "Any authority, officer, board, council or tribunal exercising functions under the CGST/IGST Acts."@en .

gst:ProperOfficer a owl:Class ; rdfs:subClassOf gst:GovernmentAuthority ; gst:module "Core" ;
    gst:legalCitation "Sec 2(91), CGST Act 2017" ; rdfs:label "Proper Officer"@en .
gst:Commissioner a owl:Class ; rdfs:subClassOf gst:GovernmentAuthority ; gst:module "Core" ;
    gst:legalCitation "Sec 2(24), CGST Act 2017" ; rdfs:label "Commissioner"@en .
gst:Board a owl:Class ; rdfs:subClassOf gst:GovernmentAuthority ; gst:module "Core" ;
    gst:legalCitation "Sec 2(16), CGST Act 2017" ; rdfs:label "Board (CBIC)"@en ;
    rdfs:comment "Central Board of Indirect Taxes and Customs, constituted under the Central Boards of Revenue Act, 1963."@en .
gst:GSTCouncil a owl:Class ; rdfs:subClassOf gst:GovernmentAuthority ; gst:module "Core" ;
    gst:legalCitation "Sec 2(36), CGST Act 2017; Article 279A, Constitution of India" ; rdfs:label "GST Council"@en .
gst:AdjudicatingAuthority a owl:Class ; rdfs:subClassOf gst:GovernmentAuthority ; gst:module "Core" ;
    gst:legalCitation "Sec 2(4), CGST Act 2017" ; rdfs:label "Adjudicating Authority"@en .
gst:AppellateAuthority a owl:Class ; rdfs:subClassOf gst:GovernmentAuthority ; gst:module "Core" ;
    gst:legalCitation "Sec 2(8), Sec 107, CGST Act 2017" ; rdfs:label "Appellate Authority"@en .
gst:RevisionalAuthority a owl:Class ; rdfs:subClassOf gst:GovernmentAuthority ; gst:module "Core" ;
    gst:legalCitation "Sec 2(99), Sec 108, CGST Act 2017" ; rdfs:label "Revisional Authority"@en .
gst:AppellateTribunal a owl:Class ; rdfs:subClassOf gst:GovernmentAuthority ; gst:module "Core" ;
    gst:legalCitation "Sec 2(9), Sec 109, CGST Act 2017" ; rdfs:label "GST Appellate Tribunal"@en .
gst:AuthorityForAdvanceRuling a owl:Class ; rdfs:subClassOf gst:GovernmentAuthority ; gst:module "Core" ;
    gst:legalCitation "Sec 96, CGST Act 2017" ; rdfs:label "Authority for Advance Ruling (AAR)"@en .
gst:AppellateAuthorityForAdvanceRuling a owl:Class ; rdfs:subClassOf gst:GovernmentAuthority ; gst:module "Core" ;
    gst:legalCitation "Sec 99, CGST Act 2017" ; rdfs:label "Appellate Authority for Advance Ruling (AAAR)"@en .
gst:NationalAppellateAuthorityForAdvanceRuling a owl:Class ; rdfs:subClassOf gst:GovernmentAuthority ; gst:module "Core" ;
    gst:legalCitation "Sec 101A, CGST Act 2017" ; rdfs:label "National Appellate Authority for Advance Ruling"@en .

#################################################################
#  MODULE 2: BUSINESS / TAXPAYER
#################################################################

gst:Business a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Business" ;
    rdfs:label "Business"@en ;
    gst:legalCitation "Sec 2(17), CGST Act 2017" ;
    rdfs:comment "Any trade, commerce, manufacture, profession, vocation, adventure, wager, or similar activity, whether or not for pecuniary benefit, per the Sec 2(17) definition of 'business'."@en .

gst:TaxablePerson a owl:Class ; rdfs:subClassOf gst:Business ; gst:module "Business" ;
    gst:legalCitation "Sec 2(107), CGST Act 2017" ;
    rdfs:label "Taxable Person"@en ;
    rdfs:comment "A person who is registered or liable to be registered under Sec 22 or Sec 24."@en .

gst:RegisteredPerson a owl:Class ; rdfs:subClassOf gst:TaxablePerson ; gst:module "Business" ;
    gst:legalCitation "Sec 2(94), CGST Act 2017" ; rdfs:label "Registered Person"@en .

gst:UnregisteredPerson a owl:Class ; rdfs:subClassOf gst:Business ; gst:module "Business" ; rdfs:label "Unregistered Person"@en .

gst:MandatorilyRegisterableBusiness a owl:Class ; rdfs:subClassOf gst:Business ; gst:module "Business" ;
    gst:legalCitation "Sec 22, Sec 24, CGST Act 2017" ;
    rdfs:label "Mandatorily Registerable Business"@en ;
    rdfs:comment "A Business that has crossed its applicable Sec 22 aggregate-turnover threshold, or falls under one of the Sec 24 compulsory-registration categories, and is therefore liable to be registered irrespective of turnover."@en .

gst:TaxablePerson owl:equivalentClass [
    a owl:Class ;
    owl:unionOf ( gst:RegisteredPerson gst:MandatorilyRegisterableBusiness )
] .

### --- Business Type (industry classification, used for composition/rate purposes) ---

gst:BusinessType a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Business" ;
    rdfs:label "Business Type"@en ;
    rdfs:comment "Classification of a business by the nature of its economic activity, relevant to registration category, composition-scheme rate, and applicable exemptions."@en .

gst:Manufacturer a owl:Class ; rdfs:subClassOf gst:BusinessType ; gst:module "Business" ; rdfs:label "Manufacturer"@en .
gst:Trader a owl:Class ; rdfs:subClassOf gst:BusinessType ; gst:module "Business" ; rdfs:label "Trader"@en .
gst:ServiceProvider a owl:Class ; rdfs:subClassOf gst:BusinessType ; gst:module "Business" ; rdfs:label "Service Provider"@en .
gst:Exporter a owl:Class ; rdfs:subClassOf gst:BusinessType ; gst:module "Business" ; rdfs:label "Exporter"@en .
gst:Importer a owl:Class ; rdfs:subClassOf gst:BusinessType ; gst:module "Business" ; rdfs:label "Importer"@en .
gst:GoodsTransportAgency a owl:Class ; rdfs:subClassOf gst:BusinessType ; gst:module "Business" ;
    rdfs:label "Goods Transport Agency"@en .
gst:Agriculturist a owl:Class ; rdfs:subClassOf gst:BusinessType ; gst:module "Business" ;
    gst:legalCitation "Sec 2(7), CGST Act 2017" ;
    rdfs:comment "An agriculturist, to the extent of supply of produce out of cultivation of land, is not liable for registration per Sec 23(1)(b)."@en ;
    rdfs:label "Agriculturist"@en .

gst:ECommerceOperator a owl:Class ; rdfs:subClassOf gst:BusinessType ; gst:module "Business" ;
    gst:legalCitation "Sec 2(45), Sec 24(x), CGST Act 2017" ;
    rdfs:label "Electronic Commerce Operator"@en ;
    rdfs:comment "Any person who owns/operates/manages a digital or electronic facility or platform for electronic commerce; compulsorily registerable under Sec 24."@en .

gst:CasualTaxablePerson a owl:Class ; rdfs:subClassOf gst:BusinessType ; gst:module "Business" ;
    gst:legalCitation "Sec 2(20), Sec 24(ii), CGST Act 2017" ;
    rdfs:label "Casual Taxable Person"@en ;
    rdfs:comment "A person who occasionally undertakes transactions involving supply of goods/services in a State/UT where he has no fixed place of business."@en .

gst:NonResidentTaxablePerson a owl:Class ; rdfs:subClassOf gst:BusinessType ; gst:module "Business" ;
    gst:legalCitation "Sec 2(77), Sec 24(v), CGST Act 2017" ;
    rdfs:label "Non-Resident Taxable Person"@en ;
    rdfs:comment "A person who occasionally undertakes transactions involving supply of goods/services but has no fixed place of business or residence in India."@en .

gst:InputServiceDistributor a owl:Class ; rdfs:subClassOf gst:BusinessType ; gst:module "Business" ;
    gst:legalCitation "Sec 2(61), Sec 24(viii), CGST Act 2017" ;
    rdfs:label "Input Service Distributor (ISD)"@en ;
    rdfs:comment "An office of the supplier of goods/services that receives tax invoices for input services and distributes the credit to other GSTINs of the same PAN."@en .

gst:CompositionTaxpayer a owl:Class ; rdfs:subClassOf gst:RegisteredPerson ; gst:module "Business" ;
    gst:legalCitation "Sec 10, CGST Act 2017" ;
    rdfs:label "Composition Taxpayer"@en ;
    rdfs:comment "A registered person who has opted to pay tax under the Sec 10 composition levy, subject to the applicable aggregate-turnover threshold and eligibility conditions."@en .

gst:MSME a owl:Class ; rdfs:subClassOf gst:BusinessType ; gst:module "Business" ;
    rdfs:label "Micro, Small or Medium Enterprise"@en ;
    gst:sourceNote "Not defined under the CGST/IGST Acts; MSME classification derives from the MSME Development Act, 2006 (a separate statute). Included here as a stub for the AuditSure MSME-facing use case and for planned cross-domain extension - see Future Extensions. No numeric MSME investment/turnover thresholds are asserted since they are outside the GST Manual's scope."@en .

[ a owl:AllDisjointClasses ;
    owl:members ( gst:Manufacturer gst:Trader gst:ServiceProvider )
] .

#################################################################
#  MODULE 3: REGISTRATION
#################################################################

gst:GSTRegistration a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Registration" ;
    gst:legalCitation "Sec 25, CGST Act 2017; Rule 8-26, CGST Rules 2017" ;
    rdfs:label "GST Registration"@en ;
    rdfs:comment "The record of a taxpayer's registration under GST, identified by a GSTIN, having an effective date and a status."@en .

gst:RegistrationStatus a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Registration" ;
    rdfs:label "Registration Status"@en .

gst:ActiveStatus a owl:NamedIndividual, gst:RegistrationStatus ; rdfs:label "Active"@en .
gst:CancelledStatus a owl:NamedIndividual, gst:RegistrationStatus ;
    gst:legalCitation "Sec 29, CGST Act 2017" ; rdfs:label "Cancelled"@en .
gst:SuspendedStatus a owl:NamedIndividual, gst:RegistrationStatus ;
    gst:legalCitation "Sec 29, Rule 21A, CGST Rules 2017" ; rdfs:label "Suspended"@en .
gst:PendingForCancellationStatus a owl:NamedIndividual, gst:RegistrationStatus ; rdfs:label "Pending for Cancellation"@en .

gst:RegistrationStatus owl:equivalentClass [
    a owl:Class ;
    owl:oneOf ( gst:ActiveStatus gst:CancelledStatus gst:SuspendedStatus gst:PendingForCancellationStatus )
] .
[ a owl:AllDifferent ; owl:distinctMembers ( gst:ActiveStatus gst:CancelledStatus gst:SuspendedStatus gst:PendingForCancellationStatus ) ] .

gst:RegistrationCategory a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Registration" ;
    rdfs:label "Registration Category"@en ;
    rdfs:comment "The legal basis under which a Business is/would be registered."@en .

gst:VoluntaryRegistration a owl:Class ; rdfs:subClassOf gst:RegistrationCategory ; gst:module "Registration" ;
    gst:legalCitation "Sec 25(3), CGST Act 2017" ; rdfs:label "Voluntary Registration"@en .
gst:ThresholdBasedRegistration a owl:Class ; rdfs:subClassOf gst:RegistrationCategory ; gst:module "Registration" ;
    gst:legalCitation "Sec 22, CGST Act 2017" ; rdfs:label "Threshold-Based (Sec 22) Registration"@en .
gst:CompulsoryRegistration a owl:Class ; rdfs:subClassOf gst:RegistrationCategory ; gst:module "Registration" ;
    gst:legalCitation "Sec 24, CGST Act 2017" ;
    rdfs:label "Compulsory (Sec 24) Registration"@en ;
    rdfs:comment "Registration required irrespective of aggregate turnover, for the 11 categories of persons listed in Sec 24 (e.g. inter-State suppliers, casual taxable persons, persons liable under reverse charge, e-commerce operators, TDS/TCS deductors, ISDs, non-resident taxable persons, etc.)."@en .
gst:CompositionRegistration a owl:Class ; rdfs:subClassOf gst:RegistrationCategory ; gst:module "Registration" ;
    gst:legalCitation "Sec 10, CGST Act 2017" ; rdfs:label "Composition Registration"@en .
gst:CasualRegistration a owl:Class ; rdfs:subClassOf gst:RegistrationCategory ; gst:module "Registration" ;
    gst:legalCitation "Sec 27, CGST Act 2017" ; rdfs:label "Casual Taxable Person Registration"@en .
gst:NonResidentRegistration a owl:Class ; rdfs:subClassOf gst:RegistrationCategory ; gst:module "Registration" ;
    gst:legalCitation "Sec 27, CGST Act 2017" ; rdfs:label "Non-Resident Taxable Person Registration"@en .
gst:ISDRegistration a owl:Class ; rdfs:subClassOf gst:RegistrationCategory ; gst:module "Registration" ;
    gst:legalCitation "Sec 24(viii), CGST Act 2017" ; rdfs:label "Input Service Distributor Registration"@en .
gst:TDSDeductorRegistration a owl:Class ; rdfs:subClassOf gst:RegistrationCategory ; gst:module "Registration" ;
    gst:legalCitation "Sec 24(vi), Sec 51, CGST Act 2017" ; rdfs:label "TDS Deductor Registration"@en .
gst:TCSCollectorRegistration a owl:Class ; rdfs:subClassOf gst:RegistrationCategory ; gst:module "Registration" ;
    gst:legalCitation "Sec 24(x), Sec 52, CGST Act 2017" ; rdfs:label "TCS Collector Registration"@en .

gst:ExemptionFromRegistration a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Registration" ;
    gst:legalCitation "Sec 23, CGST Act 2017" ;
    rdfs:label "Exemption from Registration"@en ;
    rdfs:comment "Sec 23(1): persons engaged exclusively in supplying wholly-exempt or non-taxable goods/services, and agriculturists (to the extent of produce out of land cultivation), are not liable to register. Sec 23(2) additionally empowers the Government to notify other exempt categories."@en .

#################################################################
#  MODULE 4: TAXATION / LEVY
#################################################################

gst:Tax a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Taxation" ;
    rdfs:label "Tax"@en ;
    rdfs:comment "A component of GST leviable on a supply."@en .

gst:CentralTax a owl:Class ; rdfs:subClassOf gst:Tax ; gst:module "Taxation" ;
    gst:legalCitation "Sec 2(21), Sec 9, CGST Act 2017" ; rdfs:label "Central Tax (CGST)"@en .
gst:StateTax a owl:Class ; rdfs:subClassOf gst:Tax ; gst:module "Taxation" ;
    rdfs:label "State Tax (SGST)"@en ; gst:legalCitation "SGST Act of the respective State" .
gst:UnionTerritoryTax a owl:Class ; rdfs:subClassOf gst:Tax ; gst:module "Taxation" ;
    rdfs:label "Union Territory Tax (UTGST)"@en .
gst:IntegratedTax a owl:Class ; rdfs:subClassOf gst:Tax ; gst:module "Taxation" ;
    gst:legalCitation "Sec 2(1)(f)/Sec 5, IGST Act 2017" ; rdfs:label "Integrated Tax (IGST)"@en .
gst:CompensationCess a owl:Class ; rdfs:subClassOf gst:Tax ; gst:module "Taxation" ;
    gst:legalCitation "GST (Compensation to States) Act 2017" ; rdfs:label "Compensation Cess"@en .

[ a owl:AllDisjointClasses ; owl:members ( gst:CentralTax gst:StateTax gst:UnionTerritoryTax gst:IntegratedTax gst:CompensationCess ) ] .

gst:LevyMechanism a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Taxation" ;
    rdfs:label "Levy Mechanism"@en .

gst:ForwardCharge a owl:Class ; rdfs:subClassOf gst:LevyMechanism ; gst:module "Taxation" ;
    gst:legalCitation "Sec 9(1), CGST Act 2017" ; rdfs:label "Forward Charge"@en ;
    rdfs:comment "Tax is payable by the supplier of goods/services at the notified rate (statutory cap: not exceeding 20% CGST, mirrored by an equal SGST/UTGST rate, i.e. an effective combined cap of 40%)."@en .

gst:ReverseChargeMechanism a owl:Class ; rdfs:subClassOf gst:LevyMechanism ; gst:module "Taxation" ;
    gst:legalCitation "Sec 2(98), Sec 9(3), Sec 9(4), CGST Act 2017" ; rdfs:label "Reverse Charge Mechanism (RCM)"@en ;
    rdfs:comment "Sec 9(3): tax on notified categories of supply is payable by the recipient. Sec 9(4): tax on supply of specified goods/services by an unregistered person to a specified registered recipient is payable by the recipient on reverse charge basis."@en .

gst:CompositionLevy a owl:Class ; rdfs:subClassOf gst:LevyMechanism ; gst:module "Taxation" ;
    gst:legalCitation "Sec 10, CGST Act 2017" ;
    rdfs:label "Composition Levy"@en ;
    rdfs:comment "An alternative levy under which an eligible registered person pays tax at a fixed, low rate on turnover in lieu of the normal rate, and cannot collect tax from recipients or claim input tax credit."@en ;
    gst:sourceNote "The bar on collecting tax from recipients and on claiming input tax credit is per Sec 10(4), CGST Act 2017: 'A taxable person to whom the provisions of sub-section (1) or sub-section (2A) apply shall not collect any tax from the recipient... nor shall he be entitled to any credit of input tax.' This is a structural feature of the scheme (flat low rate in exchange for no ITC chain), not an amendable threshold, and is treated as reliable even though the exact clause text was not separately re-verified against the source manual's Sec 10 excerpt captured this session." .

gst:CompositionLevyGoods a owl:Class ; rdfs:subClassOf gst:CompositionLevy ; gst:module "Taxation" ;
    gst:legalCitation "Sec 10(1), CGST Act 2017" ;
    rdfs:label "Composition Levy - Sec 10(1) (Goods/Restaurant)"@en ;
    rdfs:comment "Rates: 1% of turnover (0.5% CGST + 0.5% SGST) for manufacturers; 2.5% CGST + 2.5% SGST for Schedule II para 6(b) restaurant-type suppliers; 0.5% CGST + 0.5% SGST for other eligible suppliers of goods. Threshold: aggregate turnover in the preceding FY did not exceed Rs 50 lakh, enhanceable by notification up to Rs 1.5 crore (Rs 75 lakh for specified special category States)."@en .

gst:CompositionLevyServices a owl:Class ; rdfs:subClassOf gst:CompositionLevy ; gst:module "Taxation" ;
    gst:legalCitation "Sec 10(2A), CGST Act 2017" ;
    rdfs:label "Composition Levy - Sec 10(2A) (Services)"@en ;
    rdfs:comment "Available to a registered person not otherwise eligible under Sec 10(1), whose aggregate turnover in the preceding FY did not exceed Rs 50 lakh; tax payable up to 3% CGST + 3% SGST (rate to be notified, capped at that ceiling)."@en .

#################################################################
#  MODULE 5: SUPPLY
#################################################################

gst:Supply a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Supply" ;
    gst:legalCitation "Sec 7, CGST Act 2017" ;
    rdfs:label "Supply"@en ;
    rdfs:comment "Sec 7(1): includes all forms of supply of goods/services made for consideration in the course/furtherance of business (sale, transfer, barter, exchange, licence, rental, lease, disposal), import of services for consideration, and Schedule I activities made without consideration. Sec 7(1A) supplies are classified as goods or services per Schedule II. Sec 7(2): Schedule III activities and specified government activities are treated as neither a supply of goods nor of services."@en .

gst:TaxableSupply a owl:Class ; rdfs:subClassOf gst:Supply ; gst:module "Supply" ;
    gst:legalCitation "Sec 2(108), CGST Act 2017" ; rdfs:label "Taxable Supply"@en ;
    rdfs:comment "A supply of goods or services which is leviable to tax under the Act."@en .

gst:ExemptSupply a owl:Class ; rdfs:subClassOf gst:Supply ; gst:module "Supply" ;
    gst:legalCitation "Sec 2(47), CGST Act 2017" ; rdfs:label "Exempt Supply"@en ;
    rdfs:comment "Supply of goods/services which attracts nil rate of tax, or is wholly exempt under Sec 11 (CGST) / Sec 6 (IGST), and includes non-taxable supply."@en .

gst:NilRatedSupply a owl:Class ; rdfs:subClassOf gst:ExemptSupply ; gst:module "Supply" ; rdfs:label "Nil Rated Supply"@en .
gst:WhollyExemptSupply a owl:Class ; rdfs:subClassOf gst:ExemptSupply ; gst:module "Supply" ;
    gst:legalCitation "Sec 11, CGST Act 2017" ; rdfs:label "Wholly Exempt Supply (Sec 11 notification)"@en .
gst:NonTaxableSupply a owl:Class ; rdfs:subClassOf gst:ExemptSupply ; gst:module "Supply" ;
    gst:legalCitation "Sec 2(78), CGST Act 2017" ; rdfs:label "Non-Taxable Supply"@en ;
    rdfs:comment "A supply of goods or services which is not leviable to tax under the Act (e.g. alcoholic liquor for human consumption)."@en .

gst:ExemptSupply owl:equivalentClass [
    a owl:Class ; owl:unionOf ( gst:NilRatedSupply gst:WhollyExemptSupply gst:NonTaxableSupply )
] .

gst:ZeroRatedSupply a owl:Class ; rdfs:subClassOf gst:Supply ; gst:module "Supply" ;
    gst:legalCitation "Sec 16, IGST Act 2017" ; rdfs:label "Zero Rated Supply"@en ;
    rdfs:comment "Export of goods/services, or supply of goods/services to a SEZ developer/unit; eligible for refund per Sec 16(3) IGST Act, either under bond/LUT without payment of tax, or on payment of IGST with refund claim (subject to conditions/restrictions as notified)."@en .

gst:DeemedExport a owl:Class ; rdfs:subClassOf gst:Supply ; gst:module "Supply" ;
    gst:legalCitation "Sec 147, CGST Act 2017" ; rdfs:label "Deemed Export"@en .

gst:CompositeSupply a owl:Class ; rdfs:subClassOf gst:Supply ; gst:module "Supply" ;
    gst:legalCitation "Sec 2(30), Sec 8(a), CGST Act 2017" ; rdfs:label "Composite Supply"@en ;
    rdfs:comment "Two or more taxable supplies naturally bundled and supplied in conjunction, one of which is a principal supply; taxed at the rate applicable to the principal supply."@en .

gst:MixedSupply a owl:Class ; rdfs:subClassOf gst:Supply ; gst:module "Supply" ;
    gst:legalCitation "Sec 2(74), Sec 8(b), CGST Act 2017" ; rdfs:label "Mixed Supply"@en ;
    rdfs:comment "Two or more individual supplies made in conjunction for a single price, not being a composite supply; taxed at the rate of the supply attracting the highest rate."@en .

gst:InterStateSupply a owl:Class ; rdfs:subClassOf gst:Supply ; gst:module "Supply" ;
    gst:legalCitation "Sec 7, IGST Act 2017" ; rdfs:label "Inter-State Supply"@en .
gst:IntraStateSupply a owl:Class ; rdfs:subClassOf gst:Supply ; gst:module "Supply" ;
    gst:legalCitation "Sec 8, IGST Act 2017" ; rdfs:label "Intra-State Supply"@en .

[ a owl:AllDisjointClasses ; owl:members ( gst:InterStateSupply gst:IntraStateSupply ) ] .
[ a owl:AllDisjointClasses ; owl:members ( gst:TaxableSupply gst:ExemptSupply ) ] .
[ a owl:AllDisjointClasses ; owl:members ( gst:CompositeSupply gst:MixedSupply ) ] .

#################################################################
#  MODULE 6: INPUT TAX CREDIT
#################################################################

gst:InputTaxCredit a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "ITC" ;
    gst:legalCitation "Sec 2(63), Sec 16, CGST Act 2017" ;
    rdfs:label "Input Tax Credit"@en ;
    rdfs:comment "Credit of input tax, i.e. CGST/SGST/UTGST/IGST charged on any supply of goods/services made to a registered person, usable to discharge output tax liability."@en .

gst:ITCEligibilityCondition a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "ITC" ;
    gst:legalCitation "Sec 16(2), CGST Act 2017" ;
    rdfs:label "ITC Eligibility Condition"@en ;
    rdfs:comment "Sec 16(2) conditions, ALL of which must be satisfied to avail ITC: (a) possession of a tax invoice/debit note or other prescribed document; (aa) details of the invoice/debit note communicated under Sec 37 and not restricted under Sec 38; (b) receipt of the goods/services (including 'bill-to-ship-to' deemed receipt); (c) tax charged has actually been paid to Government by the supplier; (d) return under Sec 39 has been furnished. A time bar under Sec 16(4) restricts claiming ITC after 30 November following the end of the financial year (or annual return date, if earlier)."@en .

gst:PossessionOfTaxInvoice a owl:NamedIndividual, gst:ITCEligibilityCondition ; rdfs:label "Possession of Tax Invoice/Debit Note"@en .
gst:InvoiceDetailsCommunicated a owl:NamedIndividual, gst:ITCEligibilityCondition ; rdfs:label "Invoice Details Communicated (Sec 37/38)"@en .
gst:ReceiptOfGoodsOrServices a owl:NamedIndividual, gst:ITCEligibilityCondition ; rdfs:label "Receipt of Goods or Services"@en .
gst:TaxActuallyPaidToGovernment a owl:NamedIndividual, gst:ITCEligibilityCondition ; rdfs:label "Tax Actually Paid to Government"@en .
gst:ReturnFurnished a owl:NamedIndividual, gst:ITCEligibilityCondition ; rdfs:label "Return Furnished under Sec 39"@en .
gst:PaymentWithin180Days a owl:NamedIndividual, gst:ITCEligibilityCondition ;
    gst:legalCitation "Second proviso to Sec 16(2), CGST Act 2017; Rule 37" ;
    rdfs:label "Payment to Supplier within 180 Days"@en ;
    rdfs:comment "If the recipient fails to pay the supplier (value + tax) within 180 days of the invoice, the corresponding ITC availed must be reversed with interest."@en .

gst:BlockedCredit a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "ITC" ;
    gst:legalCitation "Sec 17(5), CGST Act 2017" ;
    rdfs:label "Blocked Credit"@en ;
    rdfs:comment "Categories of input tax on which ITC is NOT available under Sec 17(5), subject to listed exceptions."@en .

gst:MotorVehicleBlockedCredit a owl:Class ; rdfs:subClassOf gst:BlockedCredit ; gst:module "ITC" ;
    gst:legalCitation "Sec 17(5)(a)/(aa), CGST Act 2017" ;
    rdfs:label "Motor Vehicle / Conveyance ITC Block"@en ;
    rdfs:comment "Blocked for motor vehicles (seating <=13 incl. driver) and vessels/aircraft used for personal transport, except when used for further supply, transport of passengers, training, or transport of goods."@en .
gst:FoodBeverageBlockedCredit a owl:Class ; rdfs:subClassOf gst:BlockedCredit ; gst:module "ITC" ;
    gst:legalCitation "Sec 17(5)(b), CGST Act 2017" ; rdfs:label "Food, Beverages, Outdoor Catering ITC Block"@en .
gst:ClubMembershipBlockedCredit a owl:Class ; rdfs:subClassOf gst:BlockedCredit ; gst:module "ITC" ;
    gst:legalCitation "Sec 17(5)(b), CGST Act 2017" ; rdfs:label "Club/Health/Fitness Membership ITC Block"@en .
gst:WorksContractBlockedCredit a owl:Class ; rdfs:subClassOf gst:BlockedCredit ; gst:module "ITC" ;
    gst:legalCitation "Sec 17(5)(c), CGST Act 2017" ;
    rdfs:label "Works Contract ITC Block"@en ;
    rdfs:comment "Blocked for works contract services for construction of an immovable property (other than plant & machinery), except where it is an input service for further supply of works contract service."@en .
gst:PersonalConsumptionBlockedCredit a owl:Class ; rdfs:subClassOf gst:BlockedCredit ; gst:module "ITC" ;
    gst:legalCitation "Sec 17(5)(g), CGST Act 2017" ; rdfs:label "Goods/Services for Personal Consumption ITC Block"@en .
gst:CompositionTaxBlockedCredit a owl:Class ; rdfs:subClassOf gst:BlockedCredit ; gst:module "ITC" ;
    gst:legalCitation "Sec 17(5)(e), CGST Act 2017" ; rdfs:label "Tax Paid under Composition Levy ITC Block"@en .

#################################################################
#  MODULE 7: INVOICES / DOCUMENTS
#################################################################

gst:Document a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Invoice" ;
    rdfs:label "GST Document"@en .

gst:TaxInvoice a owl:Class ; rdfs:subClassOf gst:Document ; gst:module "Invoice" ;
    gst:legalCitation "Sec 31, CGST Act 2017; Rule 46" ; rdfs:label "Tax Invoice"@en .
gst:BillOfSupply a owl:Class ; rdfs:subClassOf gst:Document ; gst:module "Invoice" ;
    gst:legalCitation "Sec 31(3)(c), CGST Act 2017; Rule 49" ;
    rdfs:label "Bill of Supply"@en ;
    rdfs:comment "Issued instead of a tax invoice by a registered person supplying exempted goods/services, or paying tax under the Sec 10 composition levy."@en .
gst:CreditNote a owl:Class ; rdfs:subClassOf gst:Document ; gst:module "Invoice" ;
    gst:legalCitation "Sec 34(1), CGST Act 2017" ; rdfs:label "Credit Note"@en .
gst:DebitNote a owl:Class ; rdfs:subClassOf gst:Document ; gst:module "Invoice" ;
    gst:legalCitation "Sec 34(3), CGST Act 2017" ; rdfs:label "Debit Note"@en .
gst:ReceiptVoucher a owl:Class ; rdfs:subClassOf gst:Document ; gst:module "Invoice" ;
    gst:legalCitation "Sec 31(3)(d), CGST Act 2017" ; rdfs:label "Receipt Voucher"@en .
gst:RefundVoucher a owl:Class ; rdfs:subClassOf gst:Document ; gst:module "Invoice" ;
    gst:legalCitation "Sec 31(3)(e), CGST Act 2017" ; rdfs:label "Refund Voucher"@en .
gst:PaymentVoucher a owl:Class ; rdfs:subClassOf gst:Document ; gst:module "Invoice" ;
    gst:legalCitation "Sec 31(3)(g), CGST Act 2017" ; rdfs:label "Payment Voucher (Reverse Charge)"@en .
gst:DeliveryChallan a owl:Class ; rdfs:subClassOf gst:Document ; gst:module "Invoice" ;
    gst:legalCitation "Rule 55, CGST Rules 2017" ; rdfs:label "Delivery Challan"@en .
gst:EInvoice a owl:Class ; rdfs:subClassOf gst:TaxInvoice ; gst:module "Invoice" ;
    gst:legalCitation "Rule 48(4), CGST Rules 2017; Notification 70/2019-CT & successors" ;
    rdfs:label "E-Invoice"@en ;
    rdfs:comment "A tax invoice reported to the Invoice Registration Portal (IRP) and bearing an Invoice Reference Number (IRN) and QR code, mandatory for notified classes of registered persons above the applicable aggregate-turnover threshold."@en .
gst:EWayBill a owl:Class ; rdfs:subClassOf gst:Document ; gst:module "Invoice" ;
    gst:legalCitation "Sec 68, CGST Act 2017; Rule 138, CGST Rules 2017" ;
    rdfs:label "E-Way Bill"@en ;
    rdfs:comment "Electronic document required, per Rule 138, for movement of consignments of goods whose value exceeds Rs 50,000."@en .

[ a owl:AllDisjointClasses ; owl:members ( gst:TaxInvoice gst:BillOfSupply gst:CreditNote gst:DebitNote
                                        gst:ReceiptVoucher gst:RefundVoucher gst:PaymentVoucher gst:DeliveryChallan ) ] .

#################################################################
#  MODULE 8: RETURNS
#################################################################

gst:Return a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Returns" ;
    gst:legalCitation "Chapter IX (Sec 37-48), CGST Act 2017" ;
    rdfs:label "Return"@en .

gst:OutwardSupplyReturn a owl:Class ; rdfs:subClassOf gst:Return ; gst:module "Returns" ;
    gst:legalCitation "Sec 37, CGST Act 2017" ; rdfs:label "Outward Supply Return (GSTR-1)"@en .
gst:SummaryReturn a owl:Class ; rdfs:subClassOf gst:Return ; gst:module "Returns" ;
    gst:legalCitation "Sec 39(1), CGST Act 2017" ;
    rdfs:label "Summary Self-Assessed Return (GSTR-3B)"@en .
gst:CompositionReturn a owl:Class ; rdfs:subClassOf gst:Return ; gst:module "Returns" ;
    gst:legalCitation "Sec 39(2), CGST Act 2017" ; rdfs:label "Composition Taxpayer Return (GSTR-4)"@en .
gst:NonResidentReturn a owl:Class ; rdfs:subClassOf gst:Return ; gst:module "Returns" ;
    gst:legalCitation "Sec 39(5), CGST Act 2017" ; rdfs:label "Non-Resident Taxable Person Return (GSTR-5)"@en .
gst:ISDReturn a owl:Class ; rdfs:subClassOf gst:Return ; gst:module "Returns" ;
    gst:legalCitation "Sec 39(4), CGST Act 2017" ; rdfs:label "Input Service Distributor Return (GSTR-6)"@en .
gst:TDSReturn a owl:Class ; rdfs:subClassOf gst:Return ; gst:module "Returns" ;
    gst:legalCitation "Sec 39(3), Sec 51, CGST Act 2017" ; rdfs:label "TDS Return (GSTR-7)"@en .
gst:TCSStatement a owl:Class ; rdfs:subClassOf gst:Return ; gst:module "Returns" ;
    gst:legalCitation "Sec 52(4), CGST Act 2017" ; rdfs:label "TCS Statement (GSTR-8)"@en .
gst:AnnualReturn a owl:Class ; rdfs:subClassOf gst:Return ; gst:module "Returns" ;
    gst:legalCitation "Sec 44, CGST Act 2017" ;
    rdfs:label "Annual Return (GSTR-9)"@en ;
    rdfs:comment "Every registered person (other than an ISD, casual/non-resident taxable person, and TDS/TCS persons) must furnish an annual return per Sec 44, along with a self-certified reconciliation statement (GSTR-9C) where turnover exceeds the notified threshold."@en .
gst:ReconciliationStatement a owl:Class ; rdfs:subClassOf gst:Document ; gst:module "Returns" ;
    gst:legalCitation "Sec 44, CGST Act 2017" ; rdfs:label "Self-Certified Reconciliation Statement (GSTR-9C)"@en .
gst:FinalReturn a owl:Class ; rdfs:subClassOf gst:Return ; gst:module "Returns" ;
    gst:legalCitation "Sec 45, CGST Act 2017" ;
    rdfs:label "Final Return (GSTR-10)"@en ;
    rdfs:comment "Filed within 3 months of cancellation of registration or order of cancellation, whichever is later."@en .

gst:ReturnFrequency a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Returns" ; rdfs:label "Return Frequency"@en .
gst:MonthlyFrequency a owl:NamedIndividual, gst:ReturnFrequency ; rdfs:label "Monthly"@en .
gst:QuarterlyFrequency a owl:NamedIndividual, gst:ReturnFrequency ;
    gst:legalCitation "QRMP Scheme, Notification 84/2020-CT" ; rdfs:label "Quarterly (QRMP)"@en .
gst:AnnualFrequency a owl:NamedIndividual, gst:ReturnFrequency ; rdfs:label "Annual"@en .
gst:ReturnFrequency owl:equivalentClass [ a owl:Class ; owl:oneOf ( gst:MonthlyFrequency gst:QuarterlyFrequency gst:AnnualFrequency ) ] .

#################################################################
#  MODULE 9: PAYMENT (TDS / TCS / INTEREST / LATE FEE)
#################################################################

gst:PaymentObligation a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Payment" ;
    gst:legalCitation "Chapter X (Sec 49-53A), CGST Act 2017" ; rdfs:label "Payment Obligation"@en .

gst:TaxDeductionAtSource a owl:Class ; rdfs:subClassOf gst:PaymentObligation ; gst:module "Payment" ;
    gst:legalCitation "Sec 51, CGST Act 2017" ;
    rdfs:label "Tax Deduction at Source (TDS)"@en ;
    rdfs:comment "Specified deductors (government departments, local authorities, PSUs, notified persons) must deduct tax at 1% CGST + 1% SGST (2% total, or 2% IGST) from the payment made/credited to a supplier, where the total value of a contract of taxable supply exceeds Rs 2,50,000 (excluding tax)."@en .

gst:TaxCollectionAtSource a owl:Class ; rdfs:subClassOf gst:PaymentObligation ; gst:module "Payment" ;
    gst:legalCitation "Sec 52, CGST Act 2017" ;
    rdfs:label "Tax Collection at Source (TCS)"@en ;
    rdfs:comment "Every e-commerce operator (other than an agent) must collect tax not exceeding 1% (notified at 0.5% CGST + 0.5% SGST, or 1% IGST) of the net value of taxable supplies made through it by other suppliers, where consideration is collected by the operator."@en .

gst:Interest a owl:Class ; rdfs:subClassOf gst:PaymentObligation ; gst:module "Payment" ;
    gst:legalCitation "Sec 50, CGST Act 2017" ; rdfs:label "Interest"@en .
gst:InterestOnDelayedPayment a owl:Class ; rdfs:subClassOf gst:Interest ; gst:module "Payment" ;
    gst:legalCitation "Sec 50(1), CGST Act 2017" ;
    rdfs:label "Interest on Delayed Payment of Tax"@en ;
    rdfs:comment "18% p.a. on tax paid beyond the due date, computed (since the 2021 amendment) only on the portion of tax paid by debiting the electronic cash ledger, i.e. net-of-ITC liability."@en .
gst:InterestOnWronglyAvailedITC a owl:Class ; rdfs:subClassOf gst:Interest ; gst:module "Payment" ;
    gst:legalCitation "Sec 50(3), CGST Act 2017; Rule 88B" ;
    rdfs:label "Interest on Wrongly Availed and Utilised ITC"@en ;
    rdfs:comment "24% p.a. where input tax credit has been wrongly availed AND utilised."@en .
gst:InterestOnDelayedRefund a owl:Class ; rdfs:subClassOf gst:Interest ; gst:module "Payment" ;
    gst:legalCitation "Sec 56, CGST Act 2017" ; rdfs:label "Interest on Delayed Refund"@en .

gst:LateFee a owl:Class ; rdfs:subClassOf gst:PaymentObligation ; gst:module "Payment" ;
    gst:legalCitation "Sec 47, CGST Act 2017" ; rdfs:label "Late Fee"@en .

#################################################################
#  MODULE 10: REFUND
#################################################################

gst:Refund a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Refund" ;
    gst:legalCitation "Sec 54, CGST Act 2017" ;
    rdfs:label "Refund"@en ;
    rdfs:comment "Any registered person may claim refund of tax/interest/other amount within 2 years from the relevant date. Documentary evidence of no unjust enrichment is not required for claims below Rs 2 lakh (self-certification suffices). Up to 90% of a zero-rated-supply refund claim may be granted provisionally within 60 days, subject to conditions; the balance sanctioned after verification."@en .

gst:RefundOfUnutilisedITC a owl:Class ; rdfs:subClassOf gst:Refund ; gst:module "Refund" ;
    gst:legalCitation "Sec 54(3), CGST Act 2017" ;
    rdfs:label "Refund of Unutilised Input Tax Credit"@en ;
    rdfs:comment "Available only for (a) zero-rated supplies made without payment of tax, or (b) inverted duty structure (input tax rate higher than output tax rate), excluding notified goods/services and excluding cases where export duty is payable."@en .
gst:RefundOfZeroRatedSupply a owl:Class ; rdfs:subClassOf gst:Refund ; gst:module "Refund" ; rdfs:label "Refund on Zero-Rated Supply"@en .
gst:RefundOfExcessPayment a owl:Class ; rdfs:subClassOf gst:Refund ; gst:module "Refund" ; rdfs:label "Refund of Excess Tax Paid"@en .
gst:ProvisionalRefund a owl:Class ; rdfs:subClassOf gst:Refund ; gst:module "Refund" ;
    gst:legalCitation "Sec 54(6), CGST Act 2017; Rule 91" ; rdfs:label "Provisional Refund (90%)"@en .

#################################################################
#  MODULE 11: ASSESSMENT
#################################################################

gst:Assessment a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Assessment" ;
    gst:legalCitation "Chapter XII (Sec 59-64), CGST Act 2017" ; rdfs:label "Assessment"@en .

gst:SelfAssessment a owl:Class ; rdfs:subClassOf gst:Assessment ; gst:module "Assessment" ;
    gst:legalCitation "Sec 59, CGST Act 2017" ; rdfs:label "Self-Assessment"@en .
gst:ProvisionalAssessment a owl:Class ; rdfs:subClassOf gst:Assessment ; gst:module "Assessment" ;
    gst:legalCitation "Sec 60, CGST Act 2017" ; rdfs:label "Provisional Assessment"@en .
gst:ScrutinyOfReturns a owl:Class ; rdfs:subClassOf gst:Assessment ; gst:module "Assessment" ;
    gst:legalCitation "Sec 61, CGST Act 2017" ; rdfs:label "Scrutiny of Returns"@en .
gst:AssessmentOfNonFilers a owl:Class ; rdfs:subClassOf gst:Assessment ; gst:module "Assessment" ;
    gst:legalCitation "Sec 62, CGST Act 2017" ; rdfs:label "Best Judgment Assessment of Non-Filers"@en .
gst:AssessmentOfUnregisteredPersons a owl:Class ; rdfs:subClassOf gst:Assessment ; gst:module "Assessment" ;
    gst:legalCitation "Sec 63, CGST Act 2017" ; rdfs:label "Assessment of Unregistered Persons"@en .
gst:SummaryAssessment a owl:Class ; rdfs:subClassOf gst:Assessment ; gst:module "Assessment" ;
    gst:legalCitation "Sec 64, CGST Act 2017" ;
    rdfs:label "Summary Assessment"@en ;
    rdfs:comment "In special cases, to protect revenue interest, with prior permission of Additional/Joint Commissioner."@en .

#################################################################
#  MODULE 12: AUDIT
#################################################################

gst:Audit a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Audit" ;
    gst:legalCitation "Chapter XIII (Sec 65-66), CGST Act 2017" ; rdfs:label "Audit"@en .

gst:AuditByTaxAuthorities a owl:Class ; rdfs:subClassOf gst:Audit ; gst:module "Audit" ;
    gst:legalCitation "Sec 65, CGST Act 2017" ;
    rdfs:label "Audit by Tax Authorities"@en ;
    rdfs:comment "Commissioner (or authorised officer) may undertake audit at the place of business or in office, with 15 working days prior notice; to be completed within 3 months (extendable by 6 months by Commissioner)."@en .
gst:SpecialAudit a owl:Class ; rdfs:subClassOf gst:Audit ; gst:module "Audit" ;
    gst:legalCitation "Sec 66, CGST Act 2017" ;
    rdfs:label "Special Audit"@en ;
    rdfs:comment "Directed by an officer (not below Assistant Commissioner) with Commissioner's approval, having regard to the nature/complexity of the case and interest of revenue, conducted by a nominated Chartered/Cost Accountant."@en .

#################################################################
#  MODULE 13: DEMANDS & RECOVERY
#################################################################

gst:DemandAndRecovery a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "DemandsAndRecovery" ;
    gst:legalCitation "Chapter XV (Sec 73-84), CGST Act 2017" ; rdfs:label "Demand and Recovery"@en .

gst:ShowCauseNotice a owl:Class ; rdfs:subClassOf gst:DemandAndRecovery ; gst:module "DemandsAndRecovery" ;
    rdfs:label "Show Cause Notice"@en .

gst:SCNNonFraudCase a owl:Class ; rdfs:subClassOf gst:ShowCauseNotice ; gst:module "DemandsAndRecovery" ;
    gst:legalCitation "Sec 73, CGST Act 2017 (omitted/subsumed for periods from FY 2024-25 by Sec 74A)" ;
    rdfs:label "Demand Notice - Non-Fraud (Sec 73, up to FY 2023-24)"@en ;
    rdfs:comment "Applicable where tax is unpaid/short-paid/erroneously refunded, or ITC wrongly availed/utilised, for reasons OTHER than fraud, wilful misstatement or suppression of facts."@en .
gst:SCNFraudCase a owl:Class ; rdfs:subClassOf gst:ShowCauseNotice ; gst:module "DemandsAndRecovery" ;
    gst:legalCitation "Sec 74, CGST Act 2017 (omitted/subsumed for periods from FY 2024-25 by Sec 74A)" ;
    rdfs:label "Demand Notice - Fraud (Sec 74, up to FY 2023-24)"@en ;
    rdfs:comment "Applicable where non/short payment or wrong ITC availment is BY REASON OF fraud, wilful misstatement or suppression of facts."@en .
gst:SCNUnifiedFY2025Onwards a owl:Class ; rdfs:subClassOf gst:ShowCauseNotice ; gst:module "DemandsAndRecovery" ;
    gst:legalCitation "Sec 74A, CGST Act 2017 (inserted by Finance (No. 2) Act, 2024, applicable from FY 2024-25 onwards)" ;
    rdfs:label "Unified Demand Notice (Sec 74A, FY 2024-25 onwards)"@en ;
    rdfs:comment "Replaces the Sec 73/74 dichotomy for periods from FY 2024-25 onwards with a single procedure carrying different limitation periods and penalty exposure depending on presence of fraud/wilful misstatement/suppression."@en .

gst:Recovery a owl:Class ; rdfs:subClassOf gst:DemandAndRecovery ; gst:module "DemandsAndRecovery" ;
    gst:legalCitation "Sec 79, CGST Act 2017" ; rdfs:label "Recovery of Tax"@en .

#################################################################
#  MODULE 14: PENALTIES & OFFENCES
#################################################################

gst:Offence a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Penalty" ;
    gst:legalCitation "Sec 122, CGST Act 2017" ;
    rdfs:label "Offence"@en ;
    rdfs:comment "Sec 122(1) lists 21 specified offences (e.g. supply without invoice, issuing invoice without supply, collecting-but-not-remitting tax, fraudulent ITC availment, obstruction of officers, etc.), each attracting a penalty of Rs 10,000 or the tax evaded/ITC wrongly availed (whichever is higher). Sec 122(2) prescribes a general penalty (Rs 10,000 or 10% of tax short-paid for non-fraud; the higher of Rs 10,000 or the tax evaded for fraud cases)."@en .

gst:InvoiceViolationOffence a owl:Class ; rdfs:subClassOf gst:Offence ; gst:module "Penalty" ;
    gst:legalCitation "Sec 122(1)(i)/(ii), CGST Act 2017" ; rdfs:label "Invoice-related Offence"@en .
gst:TaxCollectedNotRemittedOffence a owl:Class ; rdfs:subClassOf gst:Offence ; gst:module "Penalty" ;
    gst:legalCitation "Sec 122(1)(iii), CGST Act 2017" ; rdfs:label "Tax Collected but not Remitted (beyond 3 months)"@en .
gst:WrongfulITCOffence a owl:Class ; rdfs:subClassOf gst:Offence ; gst:module "Penalty" ;
    gst:legalCitation "Sec 122(1)(vii)-(x), CGST Act 2017" ; rdfs:label "Fraudulent/Wrongful ITC Availment Offence"@en .
gst:FailureToRegisterOffence a owl:Class ; rdfs:subClassOf gst:Offence ; gst:module "Penalty" ;
    gst:legalCitation "Sec 122(1)(xi), CGST Act 2017" ; rdfs:label "Failure to Register Offence"@en .
gst:ObstructionOfOfficerOffence a owl:Class ; rdfs:subClassOf gst:Offence ; gst:module "Penalty" ;
    gst:legalCitation "Sec 122(1)(xviii), CGST Act 2017" ; rdfs:label "Obstruction of Proper Officer Offence"@en .

gst:Penalty a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Penalty" ;
    rdfs:label "Penalty"@en .
gst:GeneralPenalty a owl:Class ; rdfs:subClassOf gst:Penalty ; gst:module "Penalty" ;
    gst:legalCitation "Sec 125, CGST Act 2017" ;
    rdfs:label "General Penalty (Sec 125)"@en ;
    rdfs:comment "Up to Rs 25,000, for contravention of any provision for which no separate penalty is specified."@en .
gst:Confiscation a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Penalty" ;
    gst:legalCitation "Sec 130, CGST Act 2017" ; rdfs:label "Confiscation of Goods/Conveyances"@en .

#################################################################
#  MODULE 15: ADVANCE RULING
#################################################################

gst:AdvanceRuling a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "AdvanceRuling" ;
    gst:legalCitation "Chapter XVII (Sec 95-106), CGST Act 2017" ;
    rdfs:label "Advance Ruling"@en ;
    rdfs:comment "A written decision by the AAR/AAAR on questions specified in Sec 97(2)/Sec 100, sought by an applicant on matters relating to classification, applicability of notifications, valuation, ITC admissibility, registration liability, or whether an activity amounts to a supply."@en .

#################################################################
#  MODULE 16: APPEALS & REVISION
#################################################################

gst:Appeal a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Appeals" ;
    gst:legalCitation "Chapter XVIII (Sec 107-118), CGST Act 2017" ; rdfs:label "Appeal"@en .

gst:AppealToAppellateAuthority a owl:Class ; rdfs:subClassOf gst:Appeal ; gst:module "Appeals" ;
    gst:legalCitation "Sec 107, CGST Act 2017" ;
    rdfs:label "Appeal to Appellate Authority"@en ;
    rdfs:comment "Filed within 3 months of communication of the decision/order (condonable by a further 1 month on sufficient cause). Pre-deposit: full amount of admitted tax/interest/fine/fee/penalty, plus 10% of the disputed tax amount (capped at Rs 20 crore)."@en .
gst:AppealToAppellateTribunal a owl:Class ; rdfs:subClassOf gst:Appeal ; gst:module "Appeals" ;
    gst:legalCitation "Sec 112, CGST Act 2017" ; rdfs:label "Appeal to GST Appellate Tribunal"@en .
gst:AppealToHighCourt a owl:Class ; rdfs:subClassOf gst:Appeal ; gst:module "Appeals" ;
    gst:legalCitation "Sec 117, CGST Act 2017" ; rdfs:label "Appeal to High Court"@en .
gst:AppealToSupremeCourt a owl:Class ; rdfs:subClassOf gst:Appeal ; gst:module "Appeals" ;
    gst:legalCitation "Sec 118, CGST Act 2017" ; rdfs:label "Appeal to Supreme Court"@en .

#################################################################
#  MODULE 17: TRANSITIONAL PROVISIONS
#################################################################

gst:TransitionalProvision a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Transitional" ;
    gst:legalCitation "Chapter XX (Sec 139-142), CGST Act 2017" ;
    rdfs:label "Transitional Provision"@en ;
    rdfs:comment "Provisions migrating registration, ITC carry-forward, and pending proceedings from the pre-GST indirect tax regime."@en .

#################################################################
#  MODULE 18: LEGAL REFERENCES
#  (Acts, Chapters, Sections, Rules, Notifications, Circulars, Schedules)
#################################################################

gst:LegalReference a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "LegalReferences" ;
    rdfs:label "Legal Reference"@en ;
    rdfs:comment "Root class for citable legal-reference artefacts: Acts, Chapters, Sections, Rules, Notifications, Circulars, Orders, Instructions, Schedules."@en .

gst:Act a owl:Class ; rdfs:subClassOf gst:LegalReference ; gst:module "LegalReferences" ; rdfs:label "Act"@en .
gst:Rules a owl:Class ; rdfs:subClassOf gst:LegalReference ; gst:module "LegalReferences" ; rdfs:label "Rules"@en .
gst:Chapter a owl:Class ; rdfs:subClassOf gst:LegalReference ; gst:module "LegalReferences" ; rdfs:label "Chapter"@en .
gst:Section a owl:Class ; rdfs:subClassOf gst:LegalReference ; gst:module "LegalReferences" ; rdfs:label "Section"@en .
gst:Rule a owl:Class ; rdfs:subClassOf gst:LegalReference ; gst:module "LegalReferences" ; rdfs:label "Rule"@en .
gst:Schedule a owl:Class ; rdfs:subClassOf gst:LegalReference ; gst:module "LegalReferences" ; rdfs:label "Schedule"@en .
gst:Notification a owl:Class ; rdfs:subClassOf gst:LegalReference ; gst:module "LegalReferences" ; rdfs:label "Notification"@en .
gst:Circular a owl:Class ; rdfs:subClassOf gst:LegalReference ; gst:module "LegalReferences" ; rdfs:label "Circular"@en .
gst:Order a owl:Class ; rdfs:subClassOf gst:LegalReference ; gst:module "LegalReferences" ; rdfs:label "Removal of Difficulties Order"@en .
gst:Instruction a owl:Class ; rdfs:subClassOf gst:LegalReference ; gst:module "LegalReferences" ; rdfs:label "Instruction"@en .

[ a owl:AllDisjointClasses ; owl:members ( gst:Act gst:Rules gst:Chapter gst:Section gst:Rule gst:Schedule
                                        gst:Notification gst:Circular gst:Order gst:Instruction ) ] .

#################################################################
#  MODULE 19: THRESHOLDS (cross-cutting reference class)
#################################################################

gst:Threshold a owl:Class ; rdfs:subClassOf gst:GSTEntity ; gst:module "Thresholds" ;
    rdfs:label "Threshold"@en ;
    rdfs:comment "A numeric monetary/temporal limit prescribed by GST law that triggers or bounds a legal consequence (registration liability, composition eligibility, TDS/e-invoicing/e-way-bill applicability, refund documentary-evidence waiver, appeal pre-deposit cap, etc.)."@en .

#################################################################
#  OBJECT PROPERTIES
#################################################################

gst:hasBusinessType a owl:ObjectProperty ; rdfs:domain gst:Business ; rdfs:range gst:BusinessType ;
    rdfs:label "hasBusinessType"@en .
gst:belongsToState a owl:ObjectProperty ; rdfs:domain gst:Business ; rdfs:range gst:State ;
    rdfs:label "belongsToState"@en .
gst:hasJurisdiction a owl:ObjectProperty ; rdfs:domain gst:Business ; rdfs:range gst:Jurisdiction ;
    rdfs:label "hasJurisdiction"@en .
gst:hasRegistrationStatus a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain gst:Business ; rdfs:range gst:RegistrationStatus ;
    rdfs:label "hasRegistrationStatus"@en .
gst:hasGSTRegistration a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain gst:RegisteredPerson ; rdfs:range gst:GSTRegistration ;
    rdfs:label "hasGSTRegistration"@en .
gst:requiresRegistration a owl:ObjectProperty ; rdfs:domain gst:Business ; rdfs:range gst:RegistrationCategory ;
    rdfs:label "requiresRegistration"@en .
gst:isEligibleForComposition a owl:ObjectProperty ; rdfs:domain gst:Business ; rdfs:range gst:CompositionLevy ;
    rdfs:label "isEligibleForComposition"@en .
gst:hasApplicableSection a owl:ObjectProperty ; rdfs:domain gst:GSTEntity ; rdfs:range gst:Section ;
    rdfs:label "hasApplicableSection"@en .
gst:governedByRule a owl:ObjectProperty ; rdfs:domain gst:GSTEntity ; rdfs:range gst:Rule ;
    rdfs:label "governedByRule"@en .
gst:requiresReturn a owl:ObjectProperty ; rdfs:domain gst:Business ; rdfs:range gst:Return ;
    rdfs:label "requiresReturn"@en .
gst:hasReturnFrequency a owl:ObjectProperty ; rdfs:domain gst:Return ; rdfs:range gst:ReturnFrequency ;
    rdfs:label "hasReturnFrequency"@en .
gst:hasPenalty a owl:ObjectProperty ; rdfs:domain gst:Offence ; rdfs:range gst:Penalty ;
    rdfs:label "hasPenalty"@en .
gst:hasInterest a owl:ObjectProperty ; rdfs:domain gst:PaymentObligation ; rdfs:range gst:Interest ;
    rdfs:label "hasInterest"@en .
gst:eligibleForRefund a owl:ObjectProperty ; rdfs:domain gst:Business ; rdfs:range gst:Refund ;
    rdfs:label "eligibleForRefund"@en .
gst:hasSupplyType a owl:ObjectProperty ; rdfs:domain gst:Business ; rdfs:range gst:Supply ;
    rdfs:label "hasSupplyType"@en .
gst:hasGSTRate a owl:ObjectProperty ; rdfs:domain gst:Supply ; rdfs:range gst:LevyMechanism ;
    rdfs:label "hasGSTRate"@en .
gst:hasInvoice a owl:ObjectProperty ; rdfs:domain gst:Supply ; rdfs:range gst:Document ;
    rdfs:label "hasInvoice"@en .
gst:hasNotification a owl:ObjectProperty ; rdfs:domain gst:LegalReference ; rdfs:range gst:Notification ;
    rdfs:label "hasNotification"@en .
gst:hasCircular a owl:ObjectProperty ; rdfs:domain gst:LegalReference ; rdfs:range gst:Circular ;
    rdfs:label "hasCircular"@en .
gst:hasThreshold a owl:ObjectProperty ; rdfs:domain gst:GSTEntity ; rdfs:range gst:Threshold ;
    rdfs:label "hasThreshold"@en .
gst:hasChapter a owl:ObjectProperty ; rdfs:domain gst:Act ; rdfs:range gst:Chapter ;
    rdfs:label "hasChapter"@en .
gst:hasSection a owl:ObjectProperty ; rdfs:domain gst:Chapter ; rdfs:range gst:Section ;
    rdfs:label "hasSection"@en .
gst:partOfAct a owl:ObjectProperty ; owl:inverseOf gst:hasChapter ; rdfs:domain gst:Chapter ; rdfs:range gst:Act ;
    rdfs:label "partOfAct"@en .
gst:belongsToInstrument a owl:ObjectProperty ; rdfs:domain gst:LegalReference ; rdfs:range gst:LegalReference ;
    rdfs:label "belongsToInstrument"@en ;
    rdfs:comment "Generic 'belongs to this Act/instrument' link for Rules, Schedules and Rule individuals (deliberately NOT the inverse of hasChapter, to avoid forcing Chapter-typing on non-Chapter LegalReference individuals)."@en .
gst:partOfChapter a owl:ObjectProperty ; owl:inverseOf gst:hasSection ; rdfs:domain gst:Section ; rdfs:range gst:Chapter ;
    rdfs:label "partOfChapter"@en .
gst:amendedBy a owl:ObjectProperty ; rdfs:domain gst:Section ; rdfs:range gst:Notification ;
    rdfs:label "amendedBy"@en .
gst:issuedUnderSection a owl:ObjectProperty ; rdfs:domain gst:Notification ; rdfs:range gst:Section ;
    rdfs:label "issuedUnderSection"@en .
gst:filedBy a owl:ObjectProperty ; rdfs:domain gst:Return ; rdfs:range gst:RegisteredPerson ;
    rdfs:label "filedBy"@en .
gst:appliesToBusinessType a owl:ObjectProperty ; rdfs:domain gst:LegalReference ; rdfs:range gst:BusinessType ;
    rdfs:label "appliesToBusinessType"@en .
gst:hasBlockedCredit a owl:ObjectProperty ; rdfs:domain gst:RegisteredPerson ; rdfs:range gst:BlockedCredit ;
    rdfs:label "hasBlockedCredit"@en .
gst:satisfiesITCCondition a owl:ObjectProperty ; rdfs:domain gst:InputTaxCredit ; rdfs:range gst:ITCEligibilityCondition ;
    rdfs:label "satisfiesITCCondition"@en .
gst:hasAdjudicatingAuthority a owl:ObjectProperty ; rdfs:domain gst:DemandAndRecovery ; rdfs:range gst:AdjudicatingAuthority ;
    rdfs:label "hasAdjudicatingAuthority"@en .
gst:hasAppellateAuthority a owl:ObjectProperty ; rdfs:domain gst:Appeal ; rdfs:range gst:AppellateAuthority ;
    rdfs:label "hasAppellateAuthority"@en .
gst:leviedUnder a owl:ObjectProperty ; rdfs:domain gst:Tax ; rdfs:range gst:Section ;
    rdfs:label "leviedUnder"@en .
gst:hasLevyMechanism a owl:ObjectProperty ; rdfs:domain gst:Supply ; rdfs:range gst:LevyMechanism ;
    rdfs:label "hasLevyMechanism"@en .

#################################################################
#  DATA PROPERTIES
#################################################################

gst:turnoverAmount a owl:DatatypeProperty ; rdfs:domain gst:Business ; rdfs:range xsd:decimal ;
    rdfs:label "turnoverAmount"@en ; rdfs:comment "Aggregate turnover in INR, per Sec 2(6) CGST Act (PAN-based, all-India, includes exempt/export/inter-State supplies, excludes inward-RCM value and taxes)."@en .
gst:gstRate a owl:DatatypeProperty ; rdfs:domain gst:LevyMechanism ; rdfs:range xsd:decimal ;
    rdfs:label "gstRate"@en ; rdfs:comment "Percentage tax rate (e.g. composition rate) as fixed in the statute/notification."@en .
gst:registrationDate a owl:DatatypeProperty ; rdfs:domain gst:GSTRegistration ; rdfs:range xsd:dateTime ;
    rdfs:label "registrationDate"@en .
gst:effectiveDate a owl:DatatypeProperty ; rdfs:domain gst:GSTEntity ; rdfs:range xsd:dateTime ;
    rdfs:label "effectiveDate"@en .
gst:interestRate a owl:DatatypeProperty ; rdfs:domain gst:Interest ; rdfs:range xsd:decimal ;
    rdfs:label "interestRate"@en .
gst:penaltyAmount a owl:DatatypeProperty ; rdfs:domain gst:Penalty ; rdfs:range xsd:decimal ;
    rdfs:label "penaltyAmount"@en .
gst:penaltyPercentage a owl:DatatypeProperty ; rdfs:domain gst:Penalty ; rdfs:range xsd:decimal ;
    rdfs:label "penaltyPercentage"@en .
gst:financialYear a owl:DatatypeProperty ; rdfs:domain gst:GSTEntity ; rdfs:range xsd:string ;
    rdfs:label "financialYear"@en ; rdfs:comment "e.g. '2025-26'."@en .
gst:gstin a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain gst:GSTRegistration ; rdfs:range xsd:string ;
    rdfs:label "gstin"@en ; rdfs:comment "15-character GST Identification Number."@en .
gst:pan a owl:DatatypeProperty ; rdfs:domain gst:Business ; rdfs:range xsd:string ; rdfs:label "PAN"@en .
gst:aadhaar a owl:DatatypeProperty ; rdfs:domain gst:Individual ; rdfs:range xsd:string ; rdfs:label "Aadhaar"@en .
gst:invoiceValue a owl:DatatypeProperty ; rdfs:domain gst:TaxInvoice ; rdfs:range xsd:decimal ; rdfs:label "invoiceValue"@en .
gst:taxAmount a owl:DatatypeProperty ; rdfs:domain gst:Document ; rdfs:range xsd:decimal ; rdfs:label "taxAmount"@en .
gst:invoiceNumber a owl:DatatypeProperty ; rdfs:domain gst:Document ; rdfs:range xsd:string ; rdfs:label "invoiceNumber"@en .
gst:invoiceDate a owl:DatatypeProperty ; rdfs:domain gst:Document ; rdfs:range xsd:dateTime ; rdfs:label "invoiceDate"@en .
gst:irn a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain gst:EInvoice ; rdfs:range xsd:string ;
    rdfs:label "irn"@en ; rdfs:comment "Invoice Reference Number issued by the Invoice Registration Portal."@en .
gst:dueDate a owl:DatatypeProperty ; rdfs:domain gst:Return ; rdfs:range xsd:dateTime ; rdfs:label "dueDate"@en .
gst:filingDate a owl:DatatypeProperty ; rdfs:domain gst:Return ; rdfs:range xsd:dateTime ; rdfs:label "filingDate"@en .
gst:lateFeeAmount a owl:DatatypeProperty ; rdfs:domain gst:LateFee ; rdfs:range xsd:decimal ; rdfs:label "lateFeeAmount"@en .
gst:appealLimitationDays a owl:DatatypeProperty ; rdfs:domain gst:Appeal ; rdfs:range xsd:integer ; rdfs:label "appealLimitationDays"@en .
gst:preDepositPercentage a owl:DatatypeProperty ; rdfs:domain gst:Appeal ; rdfs:range xsd:decimal ; rdfs:label "preDepositPercentage"@en .
gst:refundTimeLimitYears a owl:DatatypeProperty ; rdfs:domain gst:Refund ; rdfs:range xsd:integer ; rdfs:label "refundTimeLimitYears"@en .
gst:refundProcessingDays a owl:DatatypeProperty ; rdfs:domain gst:Refund ; rdfs:range xsd:integer ; rdfs:label "refundProcessingDays"@en .
gst:sectionNumber a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain gst:Section ; rdfs:range xsd:string ; rdfs:label "sectionNumber"@en .
gst:sectionTitle a owl:DatatypeProperty ; rdfs:domain gst:Section ; rdfs:range xsd:string ; rdfs:label "sectionTitle"@en .
gst:chapterNumber a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain gst:Chapter ; rdfs:range xsd:string ; rdfs:label "chapterNumber"@en .
gst:chapterTitle a owl:DatatypeProperty ; rdfs:domain gst:Chapter ; rdfs:range xsd:string ; rdfs:label "chapterTitle"@en .
gst:notificationNumber a owl:DatatypeProperty ; rdfs:domain gst:Notification ; rdfs:range xsd:string ; rdfs:label "notificationNumber"@en .
gst:notificationDate a owl:DatatypeProperty ; rdfs:domain gst:Notification ; rdfs:range xsd:dateTime ; rdfs:label "notificationDate"@en .
gst:circularNumber a owl:DatatypeProperty ; rdfs:domain gst:Circular ; rdfs:range xsd:string ; rdfs:label "circularNumber"@en .
gst:circularDate a owl:DatatypeProperty ; rdfs:domain gst:Circular ; rdfs:range xsd:dateTime ; rdfs:label "circularDate"@en .
gst:thresholdAmount a owl:DatatypeProperty ; rdfs:domain gst:Threshold ; rdfs:range xsd:decimal ; rdfs:label "thresholdAmount"@en .
gst:thresholdCurrency a owl:DatatypeProperty ; rdfs:domain gst:Threshold ; rdfs:range xsd:string ; rdfs:label "thresholdCurrency"@en .
gst:legalCitationText a owl:DatatypeProperty ; rdfs:domain gst:GSTEntity ; rdfs:range xsd:string ;
    rdfs:label "legalCitationText"@en ; rdfs:comment "Datatype-property mirror of gst:legalCitation, provided for direct OWLAPI/programmatic extraction without needing annotation-property traversal."@en .
gst:isSpecialCategory a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain gst:State ; rdfs:range xsd:boolean ;
    rdfs:label "isSpecialCategory"@en .

#################################################################
#  RESTRICTIONS
#################################################################

gst:Business rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gst:belongsToState ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty gst:hasBusinessType ; owl:cardinality "1"^^xsd:nonNegativeInteger ] .

gst:RegisteredPerson rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gst:hasRegistrationStatus ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty gst:hasGSTRegistration ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty gst:requiresReturn ; owl:minCardinality "0"^^xsd:nonNegativeInteger ] .

gst:GSTRegistration rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gst:gstin ; owl:cardinality "1"^^xsd:nonNegativeInteger ] .

gst:CompositionTaxpayer rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gst:isEligibleForComposition ; owl:someValuesFrom gst:CompositionLevy ] ,
    [ a owl:Restriction ; owl:onProperty gst:turnoverAmount ; owl:someValuesFrom xsd:decimal ] .

gst:MandatorilyRegisterableBusiness rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gst:hasThreshold ; owl:someValuesFrom gst:Threshold ] .

gst:Section rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gst:sectionNumber ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty gst:partOfChapter ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

gst:Chapter rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gst:chapterNumber ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty gst:partOfAct ; owl:cardinality "1"^^xsd:nonNegativeInteger ] .

#################################################################
#  INDIVIDUALS: ACTS, CHAPTERS AND SECTIONS
#  (Structure per source manual's INDEX pages; section numbers,
#   titles and chapter groupings preserved verbatim from the
#   statutory table of contents.)
#################################################################

gst:CGSTAct2017 a owl:NamedIndividual, gst:Act ;
    rdfs:label "Central Goods and Services Tax Act, 2017 (No. 12 of 2017)"@en .

gst:CGST_ChapterI a owl:NamedIndividual, gst:Chapter ;
    gst:chapterNumber "I" ; gst:chapterTitle "Preliminary" ;
    gst:partOfAct gst:CGSTAct2017 ; rdfs:label "Chapter I - Preliminary"@en .
gst:CGST_Section1 a owl:NamedIndividual, gst:Section ;
    gst:sectionNumber "1" ; gst:sectionTitle "Short title, extent and commencement" ;
    gst:partOfChapter gst:CGST_ChapterI ; rdfs:label "Sec 1 CGST_ - Short title, extent and commencement"@en .
gst:CGST_Section2 a owl:NamedIndividual, gst:Section ;
    gst:sectionNumber "2" ; gst:sectionTitle "Definitions" ;
    gst:partOfChapter gst:CGST_ChapterI ; rdfs:label "Sec 2 CGST_ - Definitions"@en .

gst:CGST_ChapterII a owl:NamedIndividual, gst:Chapter ;
    gst:chapterNumber "II" ; gst:chapterTitle "Administration" ;
    gst:partOfAct gst:CGSTAct2017 ; rdfs:label "Chapter II - Administration"@en .
gst:CGST_Section3 a owl:NamedIndividual, gst:Section ;
    gst:sectionNumber "3" ; gst:sectionTitle "Officers under this Act" ;
    gst:partOfChapter gst:CGST_ChapterII ; rdfs:label "Sec 3 CGST_ - Officers under this Act"@en .
gst:CGST_Section4 a owl:NamedIndividual, gst:Section ;
    gst:sectionNumber "4" ; gst:sectionTitle "Appointment of officers" ;
    gst:partOfChapter gst:CGST_ChapterII ; rdfs:label "Sec 4 CGST_ - Appointment of officers"@en .
gst:CGST_Section5 a owl:NamedIndividual, gst:Section ;
    gst:sectionNumber "5" ; gst:sectionTitle "Powers of officers" ;
    gst:partOfChapter gst:CGST_ChapterII ; rdfs:label "Sec 5 CGST_ - Powers of officers"@en .
gst:CGST_Section6 a owl:NamedIndividual, gst:Section ;
    gst:sectionNumber "6" ; gst:sectionTitle "Authorisation of officers of State tax or Union territory tax as proper officer in certain circumstances" ;
    gst:partOfChapter gst:CGST_ChapterII ; rdfs:label "Sec 6 CGST_ - Authorisation of officers of State tax or Union territory tax as proper officer in certain circumstances"@en .

gst:CGST_ChapterIII a owl:NamedIndividual, gst:Chapter ;
    gst:chapterNumber "III" ; gst:chapterTitle "Levy and Collection of Tax" ;
    gst:partOfAct gst:CGSTAct2017 ; rdfs:label "Chapter III - Levy and Collection of Tax"@en .
gst:CGST_Section7 a owl:NamedIndividual, gst:Section ;
    gst:sectionNumber "7" ; gst:sectionTitle "Scope of supply" ;
    gst:partOfChapter gst:CGST_ChapterIII ; rdfs:label "Sec 7 CGST_ - Scope of supply"@en .
gst:CGST_Section8 a owl:NamedIndividual, gst:Section ;
    gst:sectionNumber "8" ; gst:sectionTitle "Tax liability on composite and mixed supplies" ;
    gst:partOfChapter gst:CGST_ChapterIII ; rdfs:label "Sec 8 CGST_ - Tax liability on composite and mixed supplies"@en .
gst:CGST_Section9 a owl:NamedIndividual, gst:Section ;
    gst:sectionNumber "9" ; gst:sectionTitle "Levy and collection" ;
    gst:partOfChapter gst:CGST_ChapterIII ; rdfs:label "Sec 9 CGST_ - Levy and collection"@en .
gst:CGST_Section10 a owl:NamedIndividual, gst:Section ;
    gst:sectionNumber "10" ; gst:sectionTitle "Composition levy" ;
    gst:partOfChapter gst:CGST_ChapterIII ; rdfs:label "Sec 10 CGST_ - Composition levy"@en .
gst:CGST_Section11 a owl:NamedIndividual, gst:Section ;
    gst:sectionNumber "11" ; gst:sectionTitle "Power to grant exemption from tax" ;
    gst:partOfChapter gst:CGST_ChapterIII ; rdfs:label "Sec 11 CGST_ - Power to grant exemption from tax"@en .
gst:CGST_Section11A a owl:NamedIndividual, gst:Section ;
    gst:sectionNumber "11A" ; gst:sectionTitle "Power not to recover Goods and Services Tax not levied or short-levied as a result of general practice" ;
    gst:partOfChapter gst:CGST_ChapterIII ; rdfs:label "Sec 11A CGST_ - Power not to recover Goods and Services Tax not levied or short-levied as a result of general practice"@en .

gst:CGST_ChapterIV a owl:NamedIndividual, gst:Chapter ;
    gst:chapterNumber "IV" ; gst:chapterTitle "Time and Value of Supply" ;
    gst:partOfAct gst:CGSTAct2017 ; rdfs:label "Chapter IV - Time and Value of Supply"@en .
gst:CGST_Section12 a owl:NamedIndividual, gst:Section ;
    gst:sectionNumber "12" ; gst:sectionTitle "Time of supply of goods" ;
    gst:partOfChapter gst:CGST_ChapterIV ; rdfs:label "Sec 12 CGST_ - Time of supply of goods"@en .

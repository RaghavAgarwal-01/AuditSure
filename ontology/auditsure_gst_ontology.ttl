    gst:notificationNumber "10/2019-CT" ;
    gst:issuedUnderSection gst:CGST_Section22 ;
    rdfs:comment "Notified enhancement of the Sec 22 registration threshold to Rs 40 lakh for suppliers engaged exclusively in the supply of goods (subject to State-wise adoption and conditions)."@en ;
    rdfs:label "Notification 10/2019-CT"@en .
gst:Notification_33_2017_CT a owl:NamedIndividual, gst:Notification ;
    gst:notificationNumber "33/2017-CT" ; gst:notificationDate "2017-09-15T00:00:00"^^xsd:dateTime ;
    gst:issuedUnderSection gst:CGST_Section51 ;
    rdfs:label "Notification 33/2017-CT (notifying Sec 51 for TDS)"@en .
gst:Notification_50_2018_CT a owl:NamedIndividual, gst:Notification ;
    gst:notificationNumber "50/2018-CT" ; gst:notificationDate "2018-09-13T00:00:00"^^xsd:dateTime ;
    gst:issuedUnderSection gst:CGST_Section51 ;
    rdfs:comment "Brought Sec 51 (TDS) into force w.e.f. 01.10.2018."@en ;
    rdfs:label "Notification 50/2018-CT"@en .
gst:Notification_51_2018_CT a owl:NamedIndividual, gst:Notification ;
    gst:notificationNumber "51/2018-CT" ; gst:notificationDate "2018-09-13T00:00:00"^^xsd:dateTime ;
    gst:issuedUnderSection gst:CGST_Section52 ;
    rdfs:comment "Brought Sec 52 (TCS) into force w.e.f. 01.10.2018."@en ;
    rdfs:label "Notification 51/2018-CT"@en .
gst:Notification_70_2019_CT a owl:NamedIndividual, gst:Notification ;
    gst:notificationNumber "70/2019-CT" ;
    rdfs:comment "Notifies the class of registered persons required to issue e-invoices."@en ;
    rdfs:label "Notification 70/2019-CT"@en .
gst:Notification_10_2023_CT a owl:NamedIndividual, gst:Notification ;
    gst:notificationNumber "10/2023-CT" ; gst:notificationDate "2023-05-10T00:00:00"^^xsd:dateTime ;
    gst:hasThreshold gst:ThresholdEInvoicing5Cr ;
    rdfs:comment "Reduced the e-invoicing aggregate-turnover threshold to Rs 5 crore, effective 01.08.2023."@en ;
    rdfs:label "Notification 10/2023-CT"@en .
gst:Notification_14_2017_CTR a owl:NamedIndividual, gst:Notification ;
    gst:notificationNumber "14/2017-CT(R)" ; gst:notificationDate "2017-06-28T00:00:00"^^xsd:dateTime ;
    gst:issuedUnderSection gst:CGST_Section7 ;
    rdfs:comment "Notifies supplies to be treated as neither a supply of goods nor of services under Sec 7(2)(b)."@en ;
    rdfs:label "Notification 14/2017-CT(R)"@en .
